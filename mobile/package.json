{
  "name": "liftcontext-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "format:check": "biome check .",
    "format": "biome check . --write",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "generate:api": "tsx scripts/export-openapi.ts && openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.ts",
    "smoke:e2e": "tsx scripts/smoke-e2e.ts",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.85.5",
    "axios": "^1.11.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.8",
    "expo-crypto": "~15.0.7",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "i18next": "^25.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@biomejs/biome": "^1.9.4",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.33.0",
    "eslint-config-expo": "~10.0.0",
    "openapi-typescript": "^7.8.0",
    "tsx": "^4.20.4",
    "typescript": "~5.9.2"
  }
}
